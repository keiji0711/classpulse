{
  "expo": {
    "owner": "dexter104",
    "name": "ClassPulse",
    "slug": "mobile",
    "scheme": "classpulse",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/classPulseLogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myclasspulse.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/classPulseLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "myClassPulse.com",
      "permissions": [
        "INTERNET",
        "com.android.vending.BILLING",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/classPulseLogo.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
